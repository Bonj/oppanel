# Copy to /etc/oppanel.env (root:root, mode 600). Read by systemd at service start.
# No spaces around '='. Quote values that contain spaces or '#'.

# Required
AMI_USER=oppanel
AMI_SECRET=
PANEL_USER=operator
PANEL_PASS=

# Where the bridge listens. Default is localhost only; set the PBX LAN address to reach it from other machines.
# Do not use 8088: Asterisk's own HTTP server uses it on FreePBX.
#LISTEN_HOST=192.168.0.10
#LISTEN_PORT=8099

# Restrict the whole panel (page and WebSocket) to these IPv4 addresses or CIDR ranges
#ALLOW_IPS=192.168.0.0/24

# Read-only database user (names, ring group membership, idle conference rooms)
#DB_USER=oppanel
#DB_PASS=
#DB_SOCKET=/run/mysqld/mysqld.sock

# Without the database: list idle conferences and name IVRs by hand
#CONF_ROOMS=800:Sales,801:Support
#IVR_NAMES=2:Main,3:Support

# Extra transfer shortcut buttons (fill the Transfer to field only)
#SHORTCUTS=Park:70,Voicemail:*101

# Keyboard-free sign-in for a wall display: https://<panel>/#t=<token>&e=<extension>
# Generate with: openssl rand -hex 24
#KIOSK_TOKEN=
#KIOSK_IPS=192.168.0.50

# Allow embedding in another site's iframe (origins only, no path, no trailing slash)
#FRAME_ANCESTORS=http://homeassistant.local:8123
